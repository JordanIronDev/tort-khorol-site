---
// Локальний масив товарів для tort_khorol
const cakes = [
  { id: 1, title: "Класичний Медовик", img: "images/medovik.jpg", tag: "Торти" },
  { id: 2, title: "Традиційний Наполеон", img: "images/napoleon.jpg", tag: "Торти" },
  { id: 3, title: "Фірмові горішки зі згущеним молоком", img: "images/gorih.jpg", tag: "Десерти" },
  { id: 4, title: "Торт Вулик", img: "images/vulik.jpg", tag: "Вулик" },
  { id: 5, title: "Тістечко Картопля", img: "images/kartopel.jpg", tag: "Картопля" },
  { id: 6, title: "Ticтечко Корзинка", img: "images/korzinka.jpg" , tag: "Корзинка"}, 
  { id: 7, title: "Печиво Рогалики", img: "images/rogaliki.jpg" , tag: "Рогалики" },
  { id: 8, title: "Печиво Мурашник", img: "images/murashnik.jpg", tag: "Мурашник"},
  { id: 9, title: "Печиво Трубочка", img: "images/trubochka.jpg", tag: "Трубочка"},
];
---

<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Торти на замовлення Хорол | tort_khorol</title>
    
    <!-- SEO Опис для Google -->
    <meta name="description" content="Домашні торти та десерти на замовлення в Хоролі. Свіжий Медовик, Наполеон, горішки зі згущеним молоком та інші солодощі з натуральних продуктів." />
    
    <!-- Open Graph (для красивих посилань у Telegram, Viber, Instagram) -->
    <meta property="og:title" content="Торти на замовлення Хорол | tort_khorol" />
    <meta property="og:description" content="Домашня випічка на замовлення. Тільки свіжі та натуральні інгредієнти. Замовляйте улюблений десерт!" />
    <meta property="og:image" content="/images/avatar.jpg" />
    <meta property="og:type" content="website" />
</head>
<body>
    <!-- Шапка профілю Instagram -->
<header class="profile-header">
  <div class="avatar-container">
    <img src="images/avatar.jpg" alt="tort_khorol" class="avatar" />
  </div>

  <div class="profile-info">
    <h1 class="username">tort_khorol</h1>
    <p class="category">Місцеві послуги</p>
    
    <div class="bio">
      <p>🎂 Домашні торти на замовлення</p>
      <p>👑 Наполеон • 🍯 Медовик • 🐜 Мурашник</p>
      <p>🌿 Локальні продукти | Хорол</p>
      <p>📱Приймаю замовлення в Viber або Telegram</p>
    </div>

    <div class="buttons">
  <a href="viber://chat?number=%2B380661732120" class="btn btn-secondary">
        📩 Viber
      </a>
      <a href="https://t.me/+380661732120" class="btn btn-primary" target="_blank">
        Telegram
      </a>
    </div>
  </div>
</header>

    <!-- Стрічка робіт (Instagram Grid) -->
    <main class="grid-container">
        {cakes.map((cake) => (
            <div class="card">
                <div class="card-image">
                    <img src={cake.img} alt={cake.title} />
                    <div class="overlay">
                        <span>{cake.title}</span>
                    </div>
                </div>
                <!-- Кнопка замовлення під фото -->
                <a 
                  href={`https://t.me/+380661732120?text=Добрий день! Хочу замовити: ${cake.title}`} 
                  class="order-btn" 
                  target="_blank"
                >
                  Замовити
                </a>
            </div>
        ))}
    </main>
</body>
</html>

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background-color: #fafafa;
        color: #262626;
        margin: 0;
        padding: 20px;
    }

    .profile-header {
        max-width: 800px;
        margin: 0 auto 30px auto;
        display: flex;
        align-items: center;
        gap: 20px;
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #dbdbdb;
    }

    .avatar {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        object-fit: cover;
        background: #eee;
    }

    .username {
        margin: 0 0 8px 0;
        font-size: 1.4rem;
    }

    .bio {
        margin: 4px 0;
        font-size: 0.95rem;
    }

    .buttons {
        margin-top: 12px;
        display: flex;
        gap: 10px;
    }

    .btn {
        text-decoration: none;
        padding: 8px 14px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        text-align: center;
    }

    .btn-primary {
        background-color: #0095f6;
        color: white;
    }

    .btn-secondary {
        background-color: #efefef;
        color: black;
    }

    .grid-container {
        max-width: 800px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
    }

    .card {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .card-image {
        position: relative;
        aspect-ratio: 1 / 1;
        background: #eee;
        border-radius: 8px;
        overflow: hidden;
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 10px;
        font-weight: bold;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .card-image:hover .overlay {
        opacity: 1;
    }

    /* Стилі для нової кнопки замовлення */
    .order-btn {
        display: block;
        text-align: center;
        background-color: #28a745;
        color: white;
        text-decoration: none;
        padding: 8px;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        transition: background-color 0.2s;
    }

    .order-btn:hover {
        background-color: #218838;
    }
</style>