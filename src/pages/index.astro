---

<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Торти на замовлення Хорол | tort_khorol</title>
    
    <!-- SEO Опис для Google -->
    <meta name="description" content="Домашні торти та десерти на замовлення в Хоролі. Свіжий Медовик, Наполеон, горішки зі згущеним молоком та інші солодощі з натуральних продуктів." />
    
    <!-- Open Graph (для красивих посилань у Telegram, Viber, Instagram) -->
    <meta property="og:title" content="Торти на замовлення Хорол | tort_khorol" />
    <meta property="og:description" content="Домашня випічка на замовлення. Тільки свіжі та натуральні інгредієнти. Замовляйте улюблений десерт!" />
    <meta property="og:image" content="/images/avatar.jpg" />
    <meta property="og:type" content="website" />
</head>
<body>
    <!-- Шапка профілю Instagram -->
<header class="profile-header">
  <div class="avatar-container">
    <img src="images/avatar.jpg" alt="tort_khorol" class="avatar" />
  </div>

  <div class="profile-info">
    <h1 class="username">tort_khorol</h1>
    <p class="category">Місцеві послуги</p>
    
    <div class="bio">
      <p>🎂 Домашні торти на замовлення</p>
      <p>👑 Наполеон • 🍯 Медовик • 🐜 Мурашник</p>
      <p>🌿 Локальні продукти | Хорол</p>
      <p>📱Приймаю замовлення в Viber або Telegram</p>
    </div>

    <div class="buttons">
  <a href="viber://chat?number=%2B380661732120" class="btn btn-secondary">
        📩 Viber
      </a>
      <a href="https://t.me/+380661732120" class="btn btn-primary" target="_blank">
        Telegram
      </a>
    </div>
  </div>
</header>

    <!-- Стрічка робіт (Instagram Grid) -->
   <main class="grid-container">
  {products.map((product) => (
    <div class="product-card">
      <div class="image-wrapper">
        <img src={product.img} alt={product.title} loading="lazy" />
      </div>
      <div class="product-info">
        <h3>{product.title}</h3>
        <p class="price">{product.price}</p>
        <a href={product.link} class="order-btn">Замовити</a>
      </div>
    </div>
  ))}
</main>

<style>
  /* Контейнер сітки — 3 колонки як в Instagram */
  .grid-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px; /* Мінімальний відступ між фото */
    max-width: 600px;
    margin: 0 auto;
    padding: 3px;
  }

  /* Картка товару */
  .product-card {
    background: #fff;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Квадратні зображення */
  .image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Текстовий блок під фото (компактний) */
  .product-info {
    padding: 6px 4px;
    text-align: center;
  }

  .product-info h3 {
    font-size: 0.75rem;
    margin: 0 0 2px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-info .price {
    font-size: 0.7rem;
    font-weight: bold;
    color: #222;
    margin: 0 0 4px 0;
  }

  .order-btn {
    display: block;
    background-color: #25d366;
    color: white;
    font-size: 0.65rem;
    font-weight: bold;
    padding: 3px 0;
    text-decoration: none;
    border-radius: 4px;
  }

  /* Адаптив для планшетів/ПК — робимо 4 або 5 колонок */
  @media (min-width: 600px) {
    .grid-container {
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      padding: 12px;
    }
  }
</style>