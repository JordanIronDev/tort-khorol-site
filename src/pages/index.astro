---

<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Торти на замовлення Хорол | tort_khorol</title>
    
    <!-- SEO Опис для Google -->
    <meta name="description" content="Домашні торти та десерти на замовлення в Хоролі. Свіжий Медовик, Наполеон, горішки зі згущеним молоком та інші солодощі з натуральних продуктів." />
    
    <!-- Open Graph (для красивих посилань у Telegram, Viber, Instagram) -->
    <meta property="og:title" content="Торти на замовлення Хорол | tort_khorol" />
    <meta property="og:description" content="Домашня випічка на замовлення. Тільки свіжі та натуральні інгредієнти. Замовляйте улюблений десерт!" />
    <meta property="og:image" content="/images/avatar.jpg" />
    <meta property="og:type" content="website" />
</head>
<body>
    <!-- Шапка профілю Instagram -->
<header class="profile-header">
  <div class="avatar-container">
    <img src="images/avatar.jpg" alt="tort_khorol" class="avatar" />
  </div>

  <div class="profile-info">
    <h1 class="username">tort_khorol</h1>
    <p class="category">Місцеві послуги</p>
    
    <div class="bio">
      <p>🎂 Домашні торти на замовлення</p>
      <p>👑 Наполеон • 🍯 Медовик • 🐜 Мурашник</p>
      <p>🌿 Локальні продукти | Хорол</p>
      <p>📱Приймаю замовлення в Viber або Telegram</p>
    </div>

    <div class="buttons">
  <a href="viber://chat?number=%2B380661732120" class="btn btn-secondary">
        📩 Viber
      </a>
      <a href="https://t.me/+380661732120" class="btn btn-primary" target="_blank">
        Telegram
      </a>
    </div>
  </div>
</header>

    <!-- Стрічка робіт (Instagram Grid) -->
   
<main class="grid-container">
  {cakes.map((cake) => (
    <div class="card">
      <div class="card-image">
        <img src={cake.img} alt={cake.title} loading="lazy" />
        <div class="overlay">
          <span>{cake.title}</span>
        </div>
      </div>

      <!-- Кнопка замовлення під фото -->
      <a
        href={`https://t.me/+380661732120?text=Добрий день! Хочу замовити: ${cake.title}`}
        class="order-btn"
        target="_blank"
      >
        Замовити
      </a>
    </div>
  )}
</main>

/* Контейнер сітки — 3 колонки як в Instagram */
.grid-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  max-width: 600px;
  margin: 0 auto;
  padding: 4px;
}

.card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 6px;
  overflow: hidden;
}

/* Квадратне фото */
.card-image {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
}

.card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Назва поверх фото або під ним */
.overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  padding: 2px 4px;
  font-size: 0.65rem;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Компактна кнопка під фото */
.order-btn {
  display: block;
  background-color: #25d366;
  color: #fff;
  text-align: center;
  font-size: 0.65rem;
  font-weight: bold;
  padding: 4px 0;
  text-decoration: none;
  margin-top: 2px;
}